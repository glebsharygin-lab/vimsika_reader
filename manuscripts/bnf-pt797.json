    },
    {
      "id": "pt797-s01-l02",
      "revision": 2,
      "surfaceId": "pt797-s01",
      "order": 2,
      "label": "Line 2",
      "regionIds": [
        "pt797-s01-l02-region"
      ],
      "script": "Tibetan",
      "hand": null,
      "status": "draft",
      "layers": {
        "diplomatic": null,
        "transliteration": {
          "text": "sems dang yïd dang rnam par shes pa dang | rnam par rïg pa zhes bya ba nï rnam grangs su gtogs pa’o || sems de yang ’dïr mtshungs par ldan ba dang | bcas par dgongs pa’o || tsam zhes bya ba smos pa nï don dgag pa’ï phyir ro || rnam par shes pa ’dï nyïd don du snang bar ’byung ste | dper na rab rïb can rnams kyïs || skra lastsogs pa mthong ba bzhïn te | don gang yang myed do || ’dïr ’dï skad ces",
          "scope": "complete",
          "status": "draft",
          "derivedFrom": null,
          "note": "Textual content of the physical line; readings follow Silk 2017 p.344, with extent checked against the scan. Reversed-i convention retained. Decorative strokes excluded; palaeographic review remains pending. The objection continues with brgal te on the next line.",
