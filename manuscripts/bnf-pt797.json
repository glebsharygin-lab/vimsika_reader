  "lines": [
    {
      "id": "pt797-s01-l01",
      "revision": 2,
      "surfaceId": "pt797-s01",
      "order": 1,
      "label": "Line 1",
      "regionIds": [
        "pt797-s01-l01-region"
      ],
      "script": "Tibetan",
      "hand": null,
      "status": "draft",
      "layers": {
        "diplomatic": {
          "text": "ཐེག་པ་ཆེན་པོ་ལ་ ཁམས་གསུམ་པ་རྣམ་པར་རྀག་པ་ཙམ་དུ་རྣམ་པར་གཞག་སྟེ།།",
          "scope": "excerpt",
          "status": "draft",
          "note": "Opening Mahāyāna assertion only. Draft Unicode transcription; reversed i encoded with U+0F80. Spacing and punctuation require palaeographic review; titles and the rest of the physical line are not included.",
          "derivedFrom": null,
          "provenance": [
            "pilot-inspection"
          ]
        },
        "transliteration": {
          "text": "rgya gar skad du | bïng shï ka ’brïd tï || || bod skad du nyï shu pa ’grel ba || ’jam dpal gzhonur gyur pa la phyag ’tsal lo || theg pa chen po la khams gsum pa rnam par rïg pa tsam du rnam par gzhag ste || mdo las kye rgyal ba’ï sras dag | ’dï lta ste | khams gsum pa ’dï ni sems tsam mo zhes ’byung ba’ï phyir ro ||",
          "scope": "complete",
          "status": "draft",
          "derivedFrom": null,
          "note": "Textual content of the physical line; readings follow Silk 2017 p.344, with extent checked against the scan. Reversed-i convention retained. Decorative strokes excluded; palaeographic review remains pending.",
          "provenance": [
            "opening-line-check",
            "silk2017"
          ]
        },
        "normalized": {
          "text": "rgya gar skad du bing shi ka ’brid ti bod skad du nyi shu pa ’grel ba ’jam dpal gzhonur gyur pa la phyag ’tsal lo theg pa chen po la khams gsum pa rnam par rig pa tsam du rnam par gzhag ste mdo las kye rgyal ba’i sras dag ’di lta ste khams gsum pa ’di ni sems tsam mo zhes ’byung ba’i phyir ro",
          "scope": "complete",
          "status": "draft",
          "note": "Editorial search form derived from the full draft transliteration, regularizing reversed i and omitting punctuation. No additional reading is supplied.",
          "derivedFrom": {
            "lineId": "pt797-s01-l01",
